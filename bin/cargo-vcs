#!/usr/bin/env bash
#
# Print the git commit that a crates.io package was published from.
#
# Usage: cargo vcs <crate> [<version>]
#
# Without a version, it takes each version of <crate> in the Cargo.lock of the current
# workspace. For a git or path dependency, it prints the source from Cargo.lock.

set -euo pipefail

crates_io="registry+https://github.com/rust-lang/crates.io-index"

usage() {
    echo "Usage: cargo vcs <crate> [<version>]" >&2
    exit 2
}

error() {
    echo "cargo-vcs: $*" >&2
}

# Cargo gives the subcommand name as the first argument.
if [[ ${1-} == vcs ]]; then
    shift
fi
if [[ $# -ne 1 && $# -ne 2 ]]; then
    usage
fi
crate=$1

workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT

print_commit() {
    local version=$1
    local package="$crate-$version"
    local info

    if ! curl -sfL -o "$workdir/$package.crate" "https://static.crates.io/crates/$crate/$package.crate"; then
        error "cannot download $crate $version from crates.io"
        return 1
    fi
    if ! info=$(tar -xzOf "$workdir/$package.crate" "$package/.cargo_vcs_info.json" 2> /dev/null); then
        error "$crate $version has no .cargo_vcs_info.json"
        return 1
    fi
    jq -r --arg name "$crate" --arg version "$version" '
        [$name, $version, .git.sha1]
        + (if .git.dirty then ["dirty"] else [] end)
        + (if (.path_in_vcs // "") != "" then ["path_in_vcs=" + .path_in_vcs] else [] end)
        | join(" ")' <<< "$info"
}

# Prints "<version> <source>" for each package of $crate in Cargo.lock. Source is "path" when
# the lock has none.
lock_entries() {
    local manifest lock
    manifest=$(cargo locate-project --workspace --message-format plain) || exit 1
    lock="$(dirname "$manifest")/Cargo.lock"
    if [[ ! -f $lock ]]; then
        error "no Cargo.lock in $(dirname "$manifest")"
        exit 1
    fi
    awk -v name="\"$crate\"" '
        function flush() {
            if (in_package && package == name) print version, (source == "" ? "path" : source)
        }
        /^\[/ {
            flush()
            in_package = ($0 == "[[package]]")
            package = version = source = ""
            next
        }
        $1 == "name" { package = $3 }
        $1 == "version" { version = $3 }
        $1 == "source" { source = $3 }
        END { flush() }
    ' "$lock" | tr -d '"'
}

if [[ $# -eq 2 ]]; then
    print_commit "$2"
    exit
fi

entries=$(lock_entries)
if [[ -z $entries ]]; then
    error "$crate is not in Cargo.lock"
    exit 1
fi

status=0
while read -r version source; do
    if [[ $source == "$crates_io" ]]; then
        print_commit "$version" || status=1
    else
        echo "$crate $version $source"
    fi
done <<< "$entries"
exit $status
