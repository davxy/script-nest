#!/bin/bash
#
# Run Sage in a docker container.

set -euo pipefail

CONF_DIR="${SAGE_CONF_DIR:-${HOME}/.sage}"
WORK_DIR="${SAGE_WORK_DIR:-.}"
DOCKER_IMAGE="${SAGE_DOCKER_IMAGE:-sagemath/sagemath}"
JUPYTER_PORT="${SAGE_JUPYTER_PORT:-8888}"
BROWSER_DELAY="${SAGE_BROWSER_DELAY:-5}"
BROWSER="${BROWSER:-firefox}"

show_help() {
    cat <<EOF
usage: sage [-h] [MODE]

Spawns Sage in a docker container.

MODES:
    (none)      Start interactive Sage shell (default)
    jupyter     Start Jupyter notebook server and open browser
    shell       Start bash shell in container

OPTIONS:
    -h, --help  Show this help message

ENVIRONMENT VARIABLES:
    SAGE_CONF_DIR        Configuration directory (default: ~/.sage)
    SAGE_WORK_DIR        Working directory (default: .)
    SAGE_DOCKER_IMAGE    Docker image (default: sagemath/sagemath)
    SAGE_JUPYTER_PORT    Jupyter port (default: 8888)
    SAGE_BROWSER_DELAY   Seconds to wait before opening browser (default: 5)
    BROWSER              Browser command for jupyter mode (default: firefox)

EXAMPLES:
    sage                            # Start interactive Sage
    sage jupyter                    # Start Jupyter notebook
    SAGE_WORK_DIR=/tmp/sage sage    # Use custom work directory
EOF
}

open_browser_later() {
    (sleep "$BROWSER_DELAY" && "$BROWSER" "http://localhost:${JUPYTER_PORT}") &
}

run_container() {
    mkdir -p "$CONF_DIR" "$WORK_DIR"

    docker run \
        -ti --rm \
        --user "$(id -u):$(id -g)" \
        -p "${JUPYTER_PORT}:${JUPYTER_PORT}" \
        -v "${CONF_DIR}:/home/sage/.sage" \
        -v "${WORK_DIR}:/home/sage/work" \
        -w "/home/sage/work" \
        "$DOCKER_IMAGE" "$@"
}

main() {
    local mode="${1:-}"

    case "$mode" in
        -h|--help)
            show_help
            ;;
        "")
            run_container
            ;;
        jupyter)
            open_browser_later
            run_container sage-jupyter
            ;;
        shell)
            run_container /bin/bash
            ;;
        *)
            echo "Error: unknown mode '$mode'" >&2
            echo "Use 'sage -h' for help" >&2
            exit 1
            ;;
    esac
}

main "$@"
