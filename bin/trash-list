#!/usr/bin/env bash
#
# Author: Davide Galassi <davxy@datawok.net>
# Version: 0.2.0
#
# Wrapper around `trash-list` (from the `trash-cli` package) that reconciles
# each trash directory before listing it:
#   - synthesizes a fallback `*.trashinfo` for any trashed file whose metadata
#     is missing, so orphaned files still show up and can be restored/removed
#   - deletes `*.trashinfo` entries whose backing file is gone

set -euo pipefail
shopt -s nullglob

readonly TRASH_LIST=/usr/bin/trash-list
# Original path recorded in synthesized metadata; restoring an orphan lands here.
readonly ORPHAN_ROOT=/tmp/trash-orphans

usage() {
  cat <<'EOF'
Usage: trash-list [-h]

Reconcile every trash directory, then list its contents:
  - synthesize fallback metadata for trashed files missing their .trashinfo
  - remove .trashinfo entries whose backing file is gone
EOF
}

# Percent-encode a string for the trashinfo `Path` field (RFC 3986, keeping
# path separators). Iterates bytes so UTF-8 names encode correctly.
urlencode() {
  local LC_ALL=C string=$1 out='' i ch
  for (( i = 0; i < ${#string}; i++ )); do
    ch=${string:i:1}
    case $ch in
      [a-zA-Z0-9._~/-]) out+=$ch ;;
      *) printf -v ch '%%%02X' "'$ch"; out+=$ch ;;
    esac
  done
  printf '%s' "$out"
}

inspect() {
  local trash_dir=$1
  local file info name
  local created=0 cleaned=0

  echo "-------------------------------------------"
  echo "Trash @ $trash_dir"

  # Synthesize metadata for files that lost their `.trashinfo`.
  for file in "$trash_dir"/files/*; do
    name=$(basename "$file")
    info="$trash_dir/info/$name.trashinfo"
    [ -e "$info" ] && continue
    echo "  + fallback metadata for \"$name\""
    cat > "$info" <<EOF
[Trash Info]
Path=$ORPHAN_ROOT/$(urlencode "$name")
DeletionDate=$(date -r "$file" "+%Y-%m-%dT%H:%M:%S")
EOF
    created=$((created + 1))
  done

  # Drop metadata whose backing file is gone.
  for info in "$trash_dir"/info/*.trashinfo; do
    name=$(basename "$info" .trashinfo)
    [ -e "$trash_dir/files/$name" ] && continue
    echo "  - orphan metadata for \"$name\""
    rm -f "$info"
    cleaned=$((cleaned + 1))
  done

  if (( created || cleaned )); then
    echo "  (reconciled: $created added, $cleaned removed)"
  fi

  "$TRASH_LIST" --trash-dir "$trash_dir"
}

main() {
  case ${1:-} in
    -h|--help) usage; return 0 ;;
  esac

  [ -x "$TRASH_LIST" ] || { echo "error: $TRASH_LIST not found" >&2; exit 1; }

  local -a dirs
  mapfile -t dirs < <("$TRASH_LIST" --trash-dirs)

  if (( ${#dirs[@]} == 0 )); then
    echo "No trash directories found."
    return 0
  fi

  local dir
  for dir in "${dirs[@]}"; do
    [ -d "$dir" ] || continue
    inspect "$dir"
  done
}

main "$@"
